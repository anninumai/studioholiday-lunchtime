# Apache hosting (Xserver etc.). GitHub Pages ignores this file entirely, so the
# same build works on both — nothing here needs to be stripped before uploading.

<IfModule mod_headers.c>
  # Everything under /_astro/ carries a content hash in its filename, so a change
  # always produces a new URL. Safe to cache forever.
  SetEnvIf Request_URI "^/_astro/" ASTRO_HASHED
  Header set Cache-Control "public, max-age=31536000, immutable" env=ASTRO_HASHED

  # /assets/ and /fonts/ are NOT hashed (the videos, the noren texture, the font
  # subsets), so they get a week — long enough to help, short enough that
  # replacing a file actually reaches people.
  SetEnvIf Request_URI "^/(assets|fonts)/" PLAIN_ASSET
  Header set Cache-Control "public, max-age=604800" env=PLAIN_ASSET

  # HTML must always revalidate or a deploy never reaches an existing visitor.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  # The page inlines its whole stylesheet (inlineStylesheets: "always"), so the
  # HTML is the biggest text payload by far and compresses very well.
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
</IfModule>
