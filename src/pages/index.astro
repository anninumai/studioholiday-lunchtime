---
import BaseLayout from "../layouts/BaseLayout.astro";
import NorenHero from "../components/NorenHero.astro";
// Redesign test: the noren curtain replaces the plain hero and now owns the
// intro video (revealed as it lifts). The standalone hero/video are parked here
// for easy rollback.
// import HeroZoom from "../components/HeroZoom.astro";
// import VideoStage from "../components/VideoStage.astro";
import MessageLead from "../components/MessageLead.astro";
import InfoCard from "../components/InfoCard.astro";
import MemberIntro from "../components/MemberIntro.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
// The lower page is three stacked cushions, each overlapping the one above by
// 1px (see .access / .member-cushion / .footer in global.css): the white contact
// sheet, the lighter-green member sheet, then the textured-green footer that
// carries the character. Pink hands straight over to the white cushion — the old
// .message2 green wrapper and its wave are gone.
---

<BaseLayout>
  <div class="bg-fixed"></div>
  <SiteHeader />

  <div class="page" id="top">
    <NorenHero />
    {/* <HeroZoom /> — parked; superseded by <NorenHero /> */}
    {/* <VideoStage /> — moved into <NorenHero /> as the revealed background */}
    <MessageLead />
    <InfoCard />
    <MemberIntro />
    <SiteFooter />
  </div>

  <appear-observer></appear-observer>

  <script>
    import "../scripts/index.ts";
  </script>
</BaseLayout>
