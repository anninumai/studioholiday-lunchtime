---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { content } from "../data/content";
import NorenHero from "../components/NorenHero.astro";
import MessageLead from "../components/MessageLead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import PhotoSection from "../components/PhotoSection.astro";
import logo from "../assets/site/studio/footer_logo.webp";

const { member, card, carousel } = content;
---

<BaseLayout>
  <div class="bg-fixed"></div>
  <SiteHeader />
  <main class="proposal-page" id="top">
    <NorenHero />
    <MessageLead />

    <section class="proposal-contact-cushion">
      <div class="proposal-contact__brand"><Image src={logo} alt="みんなでごはん会" width={340} format="webp" quality={85} /></div>
      <div class="proposal-contact__grid">
        <div class="proposal-contact__details">
          <p><span>TIME</span>{card.time}</p>
          <p><span>PLACE</span>{card.addressLines[0]}<br />{card.addressLines[1]}<br />{card.addressLines[2]}</p>
          <p><span>ACCESS</span>{card.access}</p>
          <p><span>MAP</span><a href={card.mapUrl} target="_blank" rel="noopener">{card.mapLabel}</a></p>
        </div>
        <div class="proposal-contact__guide">
          <p class="proposal-eyebrow">ACCESS GUIDE</p>
          <div class="proposal-contact__images">
            {carousel.slice(1, 3).map((slide) => (
              <Image src={slide.src} alt={slide.alt} width={720} format="webp" quality={80} loading="lazy" />
            ))}
          </div>
          <p class="proposal-caption">③ 建物の外端にある青いエレベーターで4Fまで上がる</p>
        </div>
      </div>
      <p class="proposal-contact__note">STUDIO HOLIDAYのキッチンスタッフが、腕によりをかけてお待ちしています。<br />お越しの際はSTUDIO HOLIDAYメンバー、K,D,C,,,メンバーにお声がけください。</p>
    </section>

    <section class="proposal-member-cushion">
      <div class="proposal-member__photo"><Image src={member.imageSrc} alt={member.imageAlt} widths={[340, 680]} sizes="min(100%, 340px)" format="webp" quality={80} loading="lazy" /></div>
      <div class="proposal-member__details">
        <p class="proposal-eyebrow">FOOD CREATOR</p>
        <p class="proposal-member__subrole">{member.subrole}</p>
        <h2>{member.name}</h2>
        <div class="proposal-line" aria-hidden="true"></div>
        <p class="proposal-member__copy">{member.copy.join(" ")}</p>
      </div>
    </section>

    <section class="proposal-footer-area"><PhotoSection /></section>
  </main>
  <script>
    import "../scripts/index.ts";
  </script>
</BaseLayout>

<style>
  .proposal-page { color: #373737; font-family: "Zen Maru Gothic", sans-serif; }
  .proposal-contact-cushion { position: relative; z-index: 2; width: 100%; margin: 0; padding: clamp(72px, 8vw, 136px) 9% clamp(56px, 6vw, 96px); background: #fff; border-radius: clamp(48px, 7vw, 108px) clamp(48px, 7vw, 108px) 0 0; }
  .proposal-contact__brand { margin-bottom: clamp(34px, 5vw, 70px); text-align: center; }
  .proposal-contact__brand img { width: clamp(170px, 24vw, 320px); height: auto; filter: grayscale(1); opacity: .62; }
  .proposal-contact__grid { display: grid; grid-template-columns: 27.57% 63.57%; justify-content: space-between; align-items: start; width: 81.12%; margin: 0 auto; }
  .proposal-contact__details p { margin: 0; padding: 20px 0; border-bottom: 1px solid #e7e7e7; font-size: clamp(15px, 1.11vw, 24px); line-height: 1.8; letter-spacing: .08em; }
  .proposal-contact__details span { display: inline-block; width: 92px; color: #6dbb2d; font-size: .68em; font-weight: 700; letter-spacing: .16em; vertical-align: top; }
  .proposal-contact__details a { color: inherit; text-underline-offset: 5px; }
  .proposal-eyebrow { margin: 0 0 18px; color: #6dbb2d; font-size: clamp(10px, 1vw, 15px); font-weight: 700; letter-spacing: .22em; }
  .proposal-contact__images { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; overflow: hidden; border-radius: 12px; }
  .proposal-contact__images img { display: block; width: 100%; height: clamp(180px, 24vw, 330px); object-fit: cover; }
  .proposal-caption { margin: 12px 0 0; color: #6dbb2d; font-size: clamp(11px, 1vw, 15px); letter-spacing: .08em; }
  .proposal-contact__note { width: 81.12%; margin: clamp(48px, 8vw, 100px) auto 0; padding-top: clamp(28px, 4vw, 56px); border-top: 1px solid #e7e7e7; text-align: center; font-size: clamp(14px, 1.25vw, 20px); line-height: 2.1; letter-spacing: .08em; }
  .proposal-member-cushion { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(220px, 360px) minmax(0, 1fr); align-items: center; gap: clamp(32px, 8vw, 120px); width: 100%; margin: -1px 0 0; padding: clamp(72px, 8vw, 120px) 9%; color: #fff; background-color: #b8f06a; background-image: var(--bg-canvas); background-blend-mode: screen; border-radius: clamp(48px, 7vw, 108px) clamp(48px, 7vw, 108px) 0 0; }
  .proposal-member__photo img { display: block; width: min(100%, 340px); margin: auto; border-radius: 50%; }
  .proposal-member__subrole { margin: -8px 0 16px; color: #efffdc; font-size: 14px; letter-spacing: .1em; }
  .proposal-member h2 { margin: 0; font-size: clamp(30px, 4vw, 58px); letter-spacing: .14em; }
  .proposal-line { width: 48px; height: 2px; margin: 24px 0; background: #fff; }
  .proposal-member__copy { max-width: 500px; margin: 0; font-size: clamp(15px, 1.3vw, 21px); line-height: 2.1; letter-spacing: .08em; }
  .proposal-footer-area { position: relative; z-index: 0; margin-top: -1px; padding-top: 1px; color: #fff; background: var(--color-brand-green); }
  .proposal-footer-area .photo { height: clamp(500px, 55vw, 780px); }
  @media (max-width: 1023px) {
    .proposal-contact__grid { grid-template-columns: 1fr; gap: 48px; width: 84%; }
    .proposal-contact__details p { font-size: clamp(14px, 2vw, 18px); }
    .proposal-contact__note { width: 84%; }
    .proposal-member-cushion { grid-template-columns: 1fr; gap: 38px; text-align: center; }
    .proposal-member__photo img { width: min(300px, 62vw); }
    .proposal-line { margin: 22px auto; }
    .proposal-member__copy { margin-inline: auto; }
  }
  @media (max-width: 700px) {
    .proposal-contact-cushion { padding: 56px 24px 64px; border-radius: 40px 40px 0 0; }
    .proposal-contact__grid, .proposal-contact__note { width: 100%; }
    .proposal-contact__images img { height: 170px; }
    .proposal-member-cushion { padding: 58px 24px 76px; border-radius: 40px 40px 0 0; }
  }
</style>
