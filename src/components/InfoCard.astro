---
import { Image } from "astro:assets";
import clockIcon from "../assets/site/icons/clock-4.png";
import mapIcon from "../assets/site/icons/map-pin-house.png";
import { content } from "../data/content";
const { card, carousel } = content;
// The white cushion: the first block of the lower page, handed straight over
// from the pink message. .access is the pink ground the sheet's rounded top
// corners cut into. The guidance copy and the character that used to fill a
// second row here have moved to <MemberIntro /> and <SiteFooter />.
---

<section class="access">
  <div class="card">
    <div class="card-main">
      <div class="card-info">
        <header class="card-heading">
          <p class="card-eyebrow">CONTACT</p>
          <h2>開催情報</h2>
        </header>

        <dl class="card-details">
          <div class="card-detail">
            <dt>
              <Image
                class="c-icon"
                src={clockIcon}
                alt=""
                width={20}
                height={20}
                format="webp"
                loading="lazy"
                decoding="async"
              />
              TIME
            </dt>
            <dd>{card.time}</dd>
          </div>
          <div class="card-detail">
            <dt>
              <Image
                class="c-icon"
                src={mapIcon}
                alt=""
                width={20}
                height={20}
                format="webp"
                loading="lazy"
                decoding="async"
              />
              PLACE
            </dt>
            <dd>
              {card.addressLines[0]}<br />{card.addressLines[1]}<br />{
                card.addressLines[2]
              }
            </dd>
          </div>
          <div class="card-detail">
            <dt>ACCESS</dt>
            <dd>{card.access}</dd>
          </div>
          <div class="card-detail">
            <dt>MAP</dt>
            <dd><a href={card.mapUrl} target="_blank" rel="noopener">{card.mapLabel}</a></dd>
          </div>
        </dl>
      </div>

      <div class="card-carousel">
        <p class="carousel-heading">ACCESS GUIDE</p>
        <gohan-carousel>
          <div
            class="carousel"
            role="group"
            aria-roledescription="カルーセル"
            aria-label="新大久保駅からの道順"
          >
            <div class="viewport">
              <div class="track">
                {
                  carousel.map((s) => (
                    <div class="slide">
                      <Image
                        src={s.src}
                        alt={s.alt}
                        widths={[360, 640, 960, 1200]}
                        sizes="(max-width: 1023px) 79.48vw, 63.57vw"
                        format="webp"
                        quality={80}
                        loading="lazy"
                        decoding="async"
                      />
                      <p class="cap">{s.caption}</p>
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="nav" aria-label="スライドを選択">
              {
                carousel.map((_, index) => (
                  <button
                    class="dot"
                    type="button"
                    data-slide={index}
                    aria-label={`${index + 1}枚目を表示`}
                    aria-current={index === 0 ? "true" : "false"}
                  />
                ))
              }
            </div>
          </div>
        </gohan-carousel>
      </div>
    </div>
  </div>
</section>
